<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog">

    <changeSet id="CREATE_SUBSCRIPTION" author="bataklieva">

        <createTable tableName="subscriptions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="billing_cycle" type="VARCHAR(20)"/>
            <column name="next_payment_date" type="DATE"/>
            <column name="reminder_days_before" type="INT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="DATETIME2(3)" />

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_subscription_user"
                             references="users(id)"/>
            </column>

        </createTable>

    </changeSet>

</databaseChangeLog>
